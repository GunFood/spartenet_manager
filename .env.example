# Kopieren nach .env und anpassen (.env kommt nicht ins Git)
# MariaDB/MySQL für den SparteNet Manager. Leer lassen = Speicherung in Dateien im Volume /data.
#   MariaDB-Container im selben Compose-Netz: Name des Dienstes, z. B. mariadb
#   MariaDB direkt auf dem Docker-Host:       host.docker.internal
SPARTENET_DB_HOST=
SPARTENET_DB_PORT=3306
SPARTENET_DB_NAME=spartenet
SPARTENET_DB_USER=spartenet
# 1 = verschlüsselte Verbindung (TLS), z. B. bei einer Datenbank auf einem anderen Server
SPARTENET_DB_SSL=0
# Das Datenbank-Passwort NICHT hier eintragen, sondern in ./secrets/spartenet_db_password.txt
