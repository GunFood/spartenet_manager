<?xml version="1.0" encoding="utf-8"?>
<!--
  Nur HTTPS: die Mitglieder-App spricht ausschließlich mit https://manager.wlan-im-garten.de.
  Unverschlüsseltes HTTP ist verboten, vertraut wird nur den System-Zertifikaten (keine vom Nutzer installierten CAs).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
